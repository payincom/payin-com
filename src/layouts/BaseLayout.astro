---
interface Props {
  title: string;
  description?: string;
}
const { title, description = 'PayIn non-custodial stablecoin payment infrastructure for real merchants.' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const withBase = (path: string) => `${base}/${path.replace(/^\//, '')}`;
const nav = [
  { href: withBase('/'), label: 'Home' },
  { href: withBase('/cloud/'), label: 'Cloud' },
  { href: withBase('/open/'), label: 'Open' },
  { href: withBase('/stablecoin-payments/'), label: 'Stablecoins' },
  { href: withBase('/docs/'), label: 'Docs' },
  { href: withBase('/blog/'), label: 'Blog' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700;750&family=Geist+Mono:wght@400;500;600&family=Noto+Sans+SC:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <title>{title} · PayIn</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href={withBase('/')} aria-label="PayIn home"><span class="wordmark">payin<span class="wordmark-dot"></span></span></a>
      <nav aria-label="Main navigation">
        {nav.map((item) => <a href={item.href}>{item.label}</a>)}
        <a href="https://go.payin.com/">Go ↗</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <div class="footer-inner">
        <div>
          <strong>PayIn</strong>
          <p>Non-custodial stablecoin payment infrastructure for real merchants.</p>
        </div>
        <div class="footer-links">
          <a href={withBase('/cloud/')}>Cloud</a>
          <a href={withBase('/open/')}>Open</a>
          <a href="https://go.payin.com/">Go ↗</a>
          <a href={withBase('/docs/')}>Docs</a>
        </div>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light;
    --paper: #faf8f3;
    --paper-2: #f2efe8;
    --panel: #ffffff;
    --ink: #16161a;
    --ink-2: #2a2a2e;
    --muted: #6f6d66;
    --border: #e0dacb;
    --hair: #ebe5d8;
    --cloud: #1b4ed1;
    --open: #1f6f4e;
    --go: #e07a23;
    --success: #0e8a4f;
    --warning: #b6760f;
    --danger: #c0392e;
    --radius: 18px;
    --shadow: 0 20px 60px rgb(22 22 26 / 7%);
  }
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body {
    margin: 0;
    font-family: Geist, "Noto Sans SC", ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    background:
      radial-gradient(circle at top left, rgb(27 78 209 / 8%), transparent 30rem),
      radial-gradient(circle at top right, rgb(31 111 78 / 8%), transparent 28rem),
      var(--paper);
    color: var(--ink);
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }
  a { color: inherit; text-decoration: none; }
  a:hover { text-decoration: underline; }
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    max-width: 1180px;
    margin: 0 auto;
    padding: 1rem 1.25rem;
    background: color-mix(in oklab, var(--paper) 86%, transparent);
    backdrop-filter: blur(14px) saturate(140%);
  }
  .brand { color: var(--ink); }
  .wordmark {
    display: inline-flex;
    align-items: baseline;
    gap: .08em;
    font-weight: 700;
    font-size: 1.35rem;
    letter-spacing: -.055em;
    line-height: 1;
  }
  .wordmark-dot {
    display: inline-block;
    width: .26em;
    height: .26em;
    border-radius: .04em;
    background: currentColor;
    transform: translateY(-.02em);
  }
  nav { display: flex; align-items: center; gap: 1rem; color: var(--muted); font-size: .95rem; }
  nav a:hover { color: var(--ink); }
  main { max-width: 1180px; margin: 0 auto; padding: 1.5rem 1.25rem 5rem; }
  footer { border-top: 1px solid var(--hair); color: var(--muted); padding: 2rem 1.25rem; }
  .footer-inner { max-width: 1180px; margin: 0 auto; display: flex; justify-content: space-between; gap: 2rem; }
  .footer-inner p { margin: .25rem 0 0; }
  .footer-links { display: flex; flex-wrap: wrap; gap: 1rem; }

  .hero { padding: 5rem 0 3rem; max-width: 980px; }
  .hero.wide { max-width: none; }
  .hero.compact { padding-top: 3rem; }
  .eyebrow { color: var(--cloud); font-weight: 750; text-transform: uppercase; letter-spacing: .09em; font-size: .78rem; }
  .eyebrow.small { font-size: .72rem; margin: 0 0 .55rem; }
  h1 {
    font-size: clamp(3rem, 7vw, 6.35rem);
    line-height: .96;
    margin: .5rem 0 1.25rem;
    letter-spacing: -.026em;
    max-width: 1080px;
    font-weight: 500;
    text-wrap: balance;
  }
  h2 {
    font-size: clamp(2rem, 4vw, 4rem);
    line-height: 1.05;
    margin: 0 0 1rem;
    letter-spacing: -.024em;
    font-weight: 500;
    text-wrap: balance;
  }
  h3 {
    font-size: 1.25rem;
    line-height: 1.2;
    margin: 0 0 .65rem;
    letter-spacing: -.012em;
    font-weight: 600;
  }
  p { margin: 0; }
  .lead { font-size: clamp(1.12rem, 1.8vw, 1.35rem); color: var(--muted); max-width: 850px; line-height: 1.55; }
  .section { padding: 4.5rem 0; border-top: 1px solid var(--hair); }
  .section-head { max-width: 840px; margin-bottom: 2rem; }
  .section-head p { color: var(--muted); font-size: 1.08rem; }
  .grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; }
  .grid.two { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .grid.four { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  .card {
    background: color-mix(in oklab, var(--panel) 96%, var(--paper));
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.45rem;
    box-shadow: 0 14px 44px rgb(22 22 26 / 5%);
  }
  .card.large { padding: 2rem; }
  .card.cloud { border-top: 4px solid var(--cloud); }
  .card.open { border-top: 4px solid var(--open); }
  .card.go { border-top: 4px solid var(--go); }
  .muted { color: var(--muted); }
  .actions { display: flex; flex-wrap: wrap; gap: .8rem; margin-top: 2rem; }
  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    padding: .88rem 1.15rem;
    font-weight: 750;
    background: var(--ink);
    color: white;
    border: 1px solid var(--ink);
  }
  .button:hover { text-decoration: none; transform: translateY(-1px); }
  .button.secondary { background: var(--panel); color: var(--ink); border-color: var(--border); }
  .button.cloud { background: var(--cloud); border-color: var(--cloud); }
  .button.open { background: var(--open); border-color: var(--open); }

  .hero-panel {
    display: grid;
    grid-template-columns: 1.1fr .9fr;
    gap: 2rem;
    align-items: center;
  }
  .signal-card {
    background: linear-gradient(145deg, #16161a, #24242a);
    color: white;
    border-radius: 28px;
    padding: 1.25rem;
    box-shadow: 0 30px 80px rgb(22 22 26 / 16%);
  }
  .signal-card .muted { color: rgb(255 255 255 / 68%); }
  .flow-row { display: grid; grid-template-columns: 1fr auto 1fr; gap: .75rem; align-items: center; margin-top: .75rem; }
  .flow-box { border: 1px solid rgb(255 255 255 / 16%); border-radius: 14px; padding: .9rem; background: rgb(255 255 255 / 6%); }
  .arrow { color: rgb(255 255 255 / 45%); }
  .pill-row { display: flex; flex-wrap: wrap; gap: .55rem; margin-top: 1.2rem; }
  .pill {
    display: inline-flex;
    align-items: center;
    gap: .45rem;
    border: 1px solid var(--border);
    background: var(--panel);
    border-radius: 999px;
    padding: .52rem .72rem;
    color: var(--ink-2);
    font-size: .92rem;
    font-weight: 650;
  }
  .pill.dark { background: rgb(255 255 255 / 8%); border-color: rgb(255 255 255 / 16%); color: white; }
  .coin {
    width: 1.25rem;
    height: 1.25rem;
    border-radius: 999px;
    display: inline-grid;
    place-items: center;
    font-size: .62rem;
    font-weight: 850;
    color: white;
    background: var(--cloud);
  }
  .coin.green { background: var(--success); }
  .coin.orange { background: var(--go); }
  .coin.dark { background: var(--ink-2); }
  .mode-card { display: grid; gap: 1rem; }
  .steps { display: grid; gap: .5rem; margin-top: 1rem; }
  .step { display: flex; gap: .55rem; align-items: flex-start; color: var(--muted); }
  .step::before { content: ""; width: .45rem; height: .45rem; border-radius: 99px; background: var(--cloud); margin-top: .55rem; flex: 0 0 auto; }
  .open .step::before { background: var(--open); }
  .quote-band { background: var(--ink); color: white; border-radius: 28px; padding: clamp(2rem, 5vw, 4rem); }
  .quote-band p { color: rgb(255 255 255 / 72%); font-size: 1.15rem; max-width: 820px; }
  .quote-band h2 { color: white; }
  .comparison { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
  .mini-label { font-size: .75rem; letter-spacing: .08em; text-transform: uppercase; color: var(--muted); font-weight: 750; }
  .doc-section { margin-top: 2.5rem; }
  article.card > h1 { font-size: clamp(2.2rem, 4vw, 4rem); }
  article.card p, article.card li { color: #374151; }
  article.card table { width: 100%; border-collapse: collapse; margin: 1.5rem 0; }
  article.card th, article.card td { border: 1px solid var(--border); padding: .75rem; text-align: left; vertical-align: top; }
  article.card th { background: var(--paper-2); }
  article.card code { background: #f3f0e8; border-radius: .35rem; padding: .1rem .3rem; }
  article.card pre { background: #111827; color: #f9fafb; overflow-x: auto; padding: 1rem; border-radius: .75rem; }
  article.card pre code { background: transparent; color: inherit; padding: 0; }

  @media (max-width: 960px) {
    .hero-panel, .comparison, .grid.two { grid-template-columns: 1fr; }
    .grid, .grid.four { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 720px) {
    .site-header { align-items: flex-start; flex-direction: column; position: static; }
    nav { flex-wrap: wrap; }
    main { padding-top: .5rem; }
    .grid, .grid.four { grid-template-columns: 1fr; }
    .footer-inner { flex-direction: column; }
    h1 { font-size: clamp(2.7rem, 16vw, 4.25rem); }
  }
</style>
