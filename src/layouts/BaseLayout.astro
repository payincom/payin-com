---
interface Props {
  title: string;
  description?: string;
}
const { title, description = 'PayIn non-custodial stablecoin payment infrastructure for real merchants.' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const withBase = (path: string) => `${base}/${path.replace(/^\//, '')}`;
const nav = [
  { href: withBase('/'), label: 'Home' },
  { href: withBase('/cloud/'), label: 'Cloud' },
  { href: withBase('/open/'), label: 'Open' },
  { href: withBase('/stablecoin-payments/'), label: 'Stablecoins' },
  { href: withBase('/docs/'), label: 'Docs' },
  { href: withBase('/blog/'), label: 'Blog' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700;750&family=Geist+Mono:wght@400;500;600&family=Noto+Sans+SC:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <title>{title} · PayIn</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href={withBase('/')} aria-label="PayIn home"><span class="wordmark">payin<span class="wordmark-dot"></span></span></a>
      <nav aria-label="Main navigation">
        {nav.map((item) => <a href={item.href}>{item.label}</a>)}
        <a href="https://go.payin.com/">Go ↗</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <div class="footer-inner">
        <div>
          <strong>PayIn</strong>
          <p>Non-custodial stablecoin payment infrastructure for real merchants.</p>
        </div>
        <div class="footer-links">
          <a href={withBase('/cloud/')}>Cloud</a>
          <a href={withBase('/open/')}>Open</a>
          <a href="https://go.payin.com/">Go ↗</a>
          <a href={withBase('/docs/')}>Docs</a>
        </div>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light;
    --paper: #faf8f3;
    --paper-2: #f2efe8;
    --panel: #ffffff;
    --ink: #16161a;
    --ink-2: #2a2a2e;
    --muted: #6f6d66;
    --border: #e0dacb;
    --hair: #ebe5d8;
    --cloud: #1b4ed1;
    --open: #1f6f4e;
    --go: #e07a23;
    --success: #0e8a4f;
    --warning: #b6760f;
    --danger: #c0392e;
    --radius: 18px;
    --shadow: 0 20px 60px rgb(22 22 26 / 7%);
  }
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body {
    margin: 0;
    font-family: Geist, "Noto Sans SC", ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    background:
      radial-gradient(circle at top left, rgb(27 78 209 / 8%), transparent 30rem),
      radial-gradient(circle at top right, rgb(31 111 78 / 8%), transparent 28rem),
      var(--paper);
    color: var(--ink);
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }
  a { color: inherit; text-decoration: none; }
  a:hover { text-decoration: underline; }
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    max-width: 1180px;
    margin: 0 auto;
    padding: 1rem 1.25rem;
    background: color-mix(in oklab, var(--paper) 86%, transparent);
    backdrop-filter: blur(14px) saturate(140%);
  }
  .brand { color: var(--ink); }
  .wordmark {
    display: inline-flex;
    align-items: baseline;
    gap: .08em;
    font-weight: 700;
    font-size: 1.35rem;
    letter-spacing: -.055em;
    line-height: 1;
  }
  .wordmark-dot {
    display: inline-block;
    width: .26em;
    height: .26em;
    border-radius: .04em;
    background: currentColor;
    transform: translateY(-.02em);
  }
  nav { display: flex; align-items: center; gap: 1rem; color: var(--muted); font-size: .95rem; }
  nav a:hover { color: var(--ink); }
  main { max-width: 1180px; margin: 0 auto; padding: 1.5rem 1.25rem 5rem; }
  footer { border-top: 1px solid var(--hair); color: var(--muted); padding: 2rem 1.25rem; }
  .footer-inner { max-width: 1180px; margin: 0 auto; display: flex; justify-content: space-between; gap: 2rem; }
  .footer-inner p { margin: .25rem 0 0; }
  .footer-links { display: flex; flex-wrap: wrap; gap: 1rem; }

  .hero { padding: 5rem 0 3rem; max-width: 980px; }
  .hero.wide { max-width: none; }
  .hero.compact { padding-top: 3rem; }
  .eyebrow { color: var(--cloud); font-weight: 750; text-transform: uppercase; letter-spacing: .09em; font-size: .78rem; }
  .eyebrow.small { font-size: .72rem; margin: 0 0 .55rem; }
  h1 {
    font-size: clamp(3rem, 7vw, 6.35rem);
    line-height: .96;
    margin: .5rem 0 1.25rem;
    letter-spacing: -.026em;
    max-width: 1080px;
    font-weight: 500;
    text-wrap: balance;
  }
  h2 {
    font-size: clamp(2rem, 4vw, 4rem);
    line-height: 1.05;
    margin: 0 0 1rem;
    letter-spacing: -.024em;
    font-weight: 500;
    text-wrap: balance;
  }
  h3 {
    font-size: 1.25rem;
    line-height: 1.2;
    margin: 0 0 .65rem;
    letter-spacing: -.012em;
    font-weight: 600;
  }
  p { margin: 0; }
  .lead { font-size: clamp(1.12rem, 1.8vw, 1.35rem); color: var(--muted); max-width: 850px; line-height: 1.55; }
  .section { padding: 4.5rem 0; border-top: 1px solid var(--hair); }
  .section-head { max-width: 840px; margin-bottom: 2rem; }
  .section-head p { color: var(--muted); font-size: 1.08rem; }
  .grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; }
  .grid.two { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .grid.four { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  .card {
    background: color-mix(in oklab, var(--panel) 96%, var(--paper));
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.45rem;
    box-shadow: 0 14px 44px rgb(22 22 26 / 5%);
  }
  .card.large { padding: 2rem; }
  .card.cloud { border-top: 4px solid var(--cloud); }
  .card.open { border-top: 4px solid var(--open); }
  .card.go { border-top: 4px solid var(--go); }
  .muted { color: var(--muted); }
  .actions { display: flex; flex-wrap: wrap; gap: .8rem; margin-top: 2rem; }
  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    padding: .88rem 1.15rem;
    font-weight: 750;
    background: var(--ink);
    color: white;
    border: 1px solid var(--ink);
  }
  .button:hover { text-decoration: none; transform: translateY(-1px); }
  .button.secondary { background: var(--panel); color: var(--ink); border-color: var(--border); }
  .button.cloud { background: var(--cloud); border-color: var(--cloud); }
  .button.open { background: var(--open); border-color: var(--open); }

  .hero-panel {
    display: grid;
    grid-template-columns: 1.1fr .9fr;
    gap: 2rem;
    align-items: center;
  }
  .signal-card {
    background: linear-gradient(145deg, #16161a, #24242a);
    color: white;
    border-radius: 28px;
    padding: 1.25rem;
    box-shadow: 0 30px 80px rgb(22 22 26 / 16%);
  }
  .signal-card .muted { color: rgb(255 255 255 / 68%); }
  .flow-row { display: grid; grid-template-columns: 1fr auto 1fr; gap: .75rem; align-items: center; margin-top: .75rem; }
  .flow-box { border: 1px solid rgb(255 255 255 / 16%); border-radius: 14px; padding: .9rem; background: rgb(255 255 255 / 6%); }
  .arrow { color: rgb(255 255 255 / 45%); }
  .pill-row { display: flex; flex-wrap: wrap; gap: .55rem; margin-top: 1.2rem; }
  .pill {
    display: inline-flex;
    align-items: center;
    gap: .45rem;
    border: 1px solid var(--border);
    background: var(--panel);
    border-radius: 999px;
    padding: .52rem .72rem;
    color: var(--ink-2);
    font-size: .92rem;
    font-weight: 650;
  }
  .pill.dark { background: rgb(255 255 255 / 8%); border-color: rgb(255 255 255 / 16%); color: white; }
  .coin {
    width: 1.25rem;
    height: 1.25rem;
    border-radius: 999px;
    display: inline-grid;
    place-items: center;
    font-size: .62rem;
    font-weight: 850;
    color: white;
    background: var(--cloud);
  }
  .coin.green { background: var(--success); }
  .coin.orange { background: var(--go); }
  .coin.dark { background: var(--ink-2); }
  .mode-card { display: grid; gap: 1rem; }
  .steps { display: grid; gap: .5rem; margin-top: 1rem; }
  .step { display: flex; gap: .55rem; align-items: flex-start; color: var(--muted); }
  .step::before { content: ""; width: .45rem; height: .45rem; border-radius: 99px; background: var(--cloud); margin-top: .55rem; flex: 0 0 auto; }
  .open .step::before { background: var(--open); }
  .quote-band { background: var(--ink); color: white; border-radius: 28px; padding: clamp(2rem, 5vw, 4rem); }
  .quote-band p { color: rgb(255 255 255 / 72%); font-size: 1.15rem; max-width: 820px; }
  .quote-band h2 { color: white; }
  .comparison { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
  .mini-label { font-size: .75rem; letter-spacing: .08em; text-transform: uppercase; color: var(--muted); font-weight: 750; }
  .doc-section { margin-top: 2.5rem; }
  article.card > h1 { font-size: clamp(2.2rem, 4vw, 4rem); }
  article.card p, article.card li { color: #374151; }
  article.card table { width: 100%; border-collapse: collapse; margin: 1.5rem 0; }
  article.card th, article.card td { border: 1px solid var(--border); padding: .75rem; text-align: left; vertical-align: top; }
  article.card th { background: var(--paper-2); }
  article.card code { background: #f3f0e8; border-radius: .35rem; padding: .1rem .3rem; }
  article.card pre { background: #111827; color: #f9fafb; overflow-x: auto; padding: 1rem; border-radius: .75rem; }
  article.card pre code { background: transparent; color: inherit; padding: 0; }


  .hero-kicker-row {
    display: flex;
    align-items: center;
    gap: .8rem;
    flex-wrap: wrap;
    margin-bottom: 1rem;
  }
  .trust-pill {
    display: inline-flex;
    align-items: center;
    gap: .45rem;
    border: 1px solid color-mix(in oklab, var(--open) 28%, var(--border));
    color: var(--open);
    background: color-mix(in oklab, var(--open) 8%, var(--panel));
    border-radius: 999px;
    padding: .42rem .66rem;
    font-size: .78rem;
    font-weight: 750;
  }
  .hero-proof {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, auto));
    gap: 1rem 1.4rem;
    margin-top: 2rem;
    color: var(--muted);
    font-size: .92rem;
  }
  .proof-item strong { display: block; color: var(--ink); font-size: 1rem; }
  .payment-flow-card {
    position: relative;
    min-height: 520px;
    overflow: hidden;
    background:
      radial-gradient(circle at 75% 15%, rgb(27 78 209 / 28%), transparent 18rem),
      radial-gradient(circle at 20% 80%, rgb(31 111 78 / 24%), transparent 18rem),
      linear-gradient(145deg, #151519, #25252b);
    color: white;
    border-radius: 34px;
    padding: 1.35rem;
    box-shadow: 0 38px 100px rgb(22 22 26 / 20%);
  }
  .payment-flow-card::before {
    content: "";
    position: absolute;
    inset: 1px;
    border: 1px solid rgb(255 255 255 / 10%);
    border-radius: 33px;
    pointer-events: none;
  }
  .flow-topline {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    position: relative;
    z-index: 1;
  }
  .flow-topline .mini-label { color: rgb(255 255 255 / 58%); }
  .live-dot {
    display: inline-flex;
    align-items: center;
    gap: .45rem;
    color: rgb(255 255 255 / 72%);
    font-size: .78rem;
    font-weight: 650;
  }
  .live-dot::before {
    content: "";
    width: .5rem;
    height: .5rem;
    border-radius: 99px;
    background: #4ade80;
    box-shadow: 0 0 0 6px rgb(74 222 128 / 12%);
  }
  .flow-stage {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-rows: auto 1fr auto;
    min-height: 415px;
    margin-top: 1.35rem;
  }
  .wallet-node, .merchant-node {
    width: min(100%, 22rem);
    border: 1px solid rgb(255 255 255 / 14%);
    background: rgb(255 255 255 / 7%);
    border-radius: 22px;
    padding: 1rem;
    backdrop-filter: blur(14px);
  }
  .merchant-node { justify-self: end; background: rgb(255 255 255 / 10%); }
  .node-label { color: rgb(255 255 255 / 56%); font-size: .76rem; text-transform: uppercase; letter-spacing: .08em; font-weight: 750; }
  .node-title { font-size: 1.12rem; font-weight: 700; margin-top: .2rem; }
  .node-sub { color: rgb(255 255 255 / 62%); font-size: .9rem; margin-top: .15rem; }
  .settlement-line {
    position: relative;
    min-height: 145px;
    margin: .4rem 0;
  }
  .settlement-line::before {
    content: "";
    position: absolute;
    left: 22%;
    right: 22%;
    top: 50%;
    height: 2px;
    background: linear-gradient(90deg, rgb(255 255 255 / 18%), #7aa2ff, rgb(31 111 78 / 90%));
    transform: rotate(16deg);
    transform-origin: center;
  }
  .settlement-line::after {
    content: "Stablecoin settlement";
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%) rotate(16deg);
    border: 1px solid rgb(255 255 255 / 16%);
    background: rgb(22 22 26 / 72%);
    color: rgb(255 255 255 / 74%);
    border-radius: 999px;
    padding: .45rem .65rem;
    font-size: .72rem;
    font-weight: 700;
    white-space: nowrap;
  }
  .payin-observer {
    position: absolute;
    left: 1.25rem;
    bottom: 1.25rem;
    right: 1.25rem;
    z-index: 2;
    display: grid;
    grid-template-columns: 1.05fr 1.4fr;
    gap: 1rem;
    align-items: stretch;
  }
  .observer-copy {
    border: 1px solid rgb(255 255 255 / 14%);
    background: rgb(0 0 0 / 22%);
    border-radius: 20px;
    padding: 1rem;
  }
  .observer-copy strong { display: block; font-size: 1.05rem; }
  .observer-copy span { display: block; color: rgb(255 255 255 / 62%); font-size: .86rem; margin-top: .25rem; }
  .observer-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: .55rem;
  }
  .observer-list span {
    border: 1px solid rgb(255 255 255 / 12%);
    background: rgb(255 255 255 / 7%);
    border-radius: 999px;
    padding: .55rem .65rem;
    color: rgb(255 255 255 / 78%);
    font-size: .8rem;
    font-weight: 650;
  }
  .constellation {
    position: relative;
    overflow: hidden;
    padding: clamp(2rem, 5vw, 4rem);
    border-radius: 34px;
    background:
      linear-gradient(135deg, rgb(255 255 255 / 82%), rgb(242 239 232 / 70%)),
      radial-gradient(circle at 25% 30%, rgb(27 78 209 / 16%), transparent 26rem),
      radial-gradient(circle at 75% 60%, rgb(31 111 78 / 14%), transparent 24rem);
    border: 1px solid var(--border);
    box-shadow: 0 20px 70px rgb(22 22 26 / 6%);
  }
  .constellation::before {
    content: "";
    position: absolute;
    inset: 2rem;
    background-image:
      linear-gradient(rgb(22 22 26 / 5%) 1px, transparent 1px),
      linear-gradient(90deg, rgb(22 22 26 / 5%) 1px, transparent 1px);
    background-size: 56px 56px;
    mask-image: radial-gradient(circle at center, black, transparent 72%);
    pointer-events: none;
  }
  .constellation-inner { position: relative; z-index: 1; display: grid; grid-template-columns: .9fr 1.1fr; gap: 2rem; align-items: center; }
  .constellation-copy p { color: var(--muted); font-size: 1.08rem; max-width: 34rem; }
  .orbit-map {
    position: relative;
    min-height: 390px;
  }
  .orbit-center {
    position: absolute;
    left: 50%; top: 50%;
    transform: translate(-50%, -50%);
    width: 8.5rem; height: 8.5rem;
    display: grid; place-items: center;
    border-radius: 999px;
    background: var(--ink);
    color: white;
    box-shadow: 0 24px 60px rgb(22 22 26 / 18%);
    font-weight: 800;
    letter-spacing: -.04em;
    font-size: 1.35rem;
  }
  .orbit-center::after {
    content: "Payment layer";
    position: absolute;
    bottom: -1.65rem;
    color: var(--muted);
    font-size: .74rem;
    letter-spacing: .08em;
    text-transform: uppercase;
    white-space: nowrap;
    font-weight: 750;
  }
  .orbit-ring {
    position: absolute;
    inset: 9%;
    border: 1px solid rgb(22 22 26 / 10%);
    border-radius: 999px;
  }
  .orbit-ring.two { inset: 22%; border-style: dashed; }
  .orbit-token {
    position: absolute;
    display: inline-flex;
    align-items: center;
    gap: .45rem;
    border: 1px solid rgb(22 22 26 / 10%);
    background: rgb(255 255 255 / 84%);
    backdrop-filter: blur(10px);
    border-radius: 999px;
    padding: .55rem .7rem;
    font-size: .86rem;
    font-weight: 750;
    box-shadow: 0 10px 30px rgb(22 22 26 / 7%);
  }
  .orbit-token.t1 { left: 5%; top: 18%; }
  .orbit-token.t2 { right: 10%; top: 8%; }
  .orbit-token.t3 { right: 2%; top: 45%; }
  .orbit-token.t4 { right: 18%; bottom: 7%; }
  .orbit-token.t5 { left: 19%; bottom: 5%; }
  .orbit-token.t6 { left: 0; top: 58%; }
  .orbit-token.t7 { left: 41%; top: 0; }
  .orbit-token.t8 { left: 39%; bottom: 18%; }
  .mode-showcase {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
  }
  .mode-visual-card {
    min-height: 360px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    position: relative;
    overflow: hidden;
  }
  .mode-visual-card::after {
    content: "";
    position: absolute;
    width: 18rem;
    height: 18rem;
    border-radius: 999px;
    right: -7rem;
    bottom: -8rem;
    background: color-mix(in oklab, var(--cloud) 12%, transparent);
  }
  .mode-visual-card.open::after { background: color-mix(in oklab, var(--open) 14%, transparent); }
  .mode-diagram { position: relative; z-index: 1; display: grid; gap: .65rem; margin-top: 1.6rem; }
  .mode-diagram span {
    display: flex;
    align-items: center;
    justify-content: space-between;
    border: 1px solid var(--border);
    background: rgb(255 255 255 / 58%);
    border-radius: 14px;
    padding: .72rem .85rem;
    color: var(--ink-2);
    font-weight: 650;
  }
  .mode-diagram span::after { content: "→"; color: var(--muted); }
  .mode-diagram span:last-child::after { content: "✓"; color: var(--success); }

  @media (max-width: 960px) {
    .hero-panel, .comparison, .grid.two, .constellation-inner, .mode-showcase { grid-template-columns: 1fr; }
    .grid, .grid.four { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .payment-flow-card { min-height: 560px; }
    .payin-observer { grid-template-columns: 1fr; }
  }
  @media (max-width: 720px) {
    .site-header { align-items: flex-start; flex-direction: column; position: static; }
    nav { flex-wrap: wrap; }
    main { padding-top: .5rem; }
    .grid, .grid.four { grid-template-columns: 1fr; }
    .hero-proof { grid-template-columns: 1fr; }
    .payment-flow-card { min-height: 640px; padding: 1rem; }
    .observer-list { grid-template-columns: 1fr; }
    .orbit-map { min-height: 460px; }
    .orbit-token { font-size: .78rem; }
    .footer-inner { flex-direction: column; }
    h1 { font-size: clamp(2.7rem, 16vw, 4.25rem); }
  }
</style>
