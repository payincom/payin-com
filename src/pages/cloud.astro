---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const withBase = (path: string) => `${base}/${path.replace(/^\//, '')}`;
---
<BaseLayout title="PayIn Cloud" description="Hosted stablecoin payments for online merchants: orders, deposits, hosted payment pages, webhooks, and reconciliation.">
  <section class="hero">
    <p class="eyebrow">PayIn Cloud</p>
    <h1>Hosted stablecoin payments for online merchants.</h1>
    <p class="lead">PayIn Cloud is the fastest path to stablecoin payment acceptance. PayIn operates the payment service layer; your team integrates orders, payment pages, webhooks, and reconciliation. The payment model is non-custodial: PayIn coordinates payment status without taking custody of merchant funds.</p>
    <div class="actions">
      <a class="button cloud" href={withBase('/docs/cloud/getting-started/')}>Read Cloud docs</a>
      <a class="button secondary" href={withBase('/docs/cloud/production-launch/')}>Launch checklist</a>
    </div>
  </section>

  <section class="section">
    <div class="section-head">
      <p class="eyebrow">Who it is for</p>
      <h2>For merchants who want stablecoin payments without operating payment infrastructure.</h2>
      <p>PayIn Cloud is for ecommerce, SaaS, platforms, and B2B merchants who want API-first stablecoin payments while PayIn handles the payment service layer.</p>
    </div>
    <div class="grid four">
      <article class="card"><h3>Ecommerce checkout</h3><p class="muted">Create stablecoin payment orders and redirect customers to a hosted payment page.</p></article>
      <article class="card"><h3>SaaS invoices</h3><p class="muted">Collect invoice payments and receive reliable status updates through webhooks.</p></article>
      <article class="card"><h3>Platform deposits</h3><p class="muted">Use deposit flows and assigned addresses for account funding and balances.</p></article>
      <article class="card"><h3>Global merchants</h3><p class="muted">Accept stablecoin payments from customers across supported networks and tokens.</p></article>
    </div>
  </section>

  <section class="section">
    <div class="section-head">
      <p class="eyebrow">Non-custodial trust model</p>
      <h2>Hosted service does not mean hosted funds.</h2>
      <p>PayIn Cloud hosts the payment infrastructure: APIs, payment pages, blockchain monitoring, webhooks, and operational workflows. The architecture is designed so funds settle through merchant-controlled payment destinations rather than PayIn custody.</p>
    </div>
    <div class="grid">
      <article class="card cloud"><h3>Infrastructure layer</h3><p class="muted">PayIn Cloud helps create, monitor, notify, and reconcile payments.</p></article>
      <article class="card cloud"><h3>Merchant ownership</h3><p class="muted">Merchants remain responsible for wallet custody, treasury policy, and business controls.</p></article>
      <article class="card cloud"><h3>Customer confidence</h3><p class="muted">A non-custodial payment model is easier to explain: PayIn verifies the payment flow without holding customer funds.</p></article>
    </div>
  </section>

  <section class="section">
    <div class="section-head">
      <p class="eyebrow">Integration path</p>
      <h2>From sandbox to production.</h2>
      <p>Cloud integration should be operationally safe before it handles real money.</p>
    </div>
    <div class="grid">
      <article class="card cloud"><h3>1. Start in sandbox</h3><p class="muted">Create test orders, open payment pages, test webhooks, and verify business-system updates.</p></article>
      <article class="card cloud"><h3>2. Integrate payments</h3><p class="muted">Use API keys server-side, create order payments, process webhooks idempotently, and prepare reconciliation.</p></article>
      <article class="card cloud"><h3>3. Launch production</h3><p class="muted">Separate production secrets, verify support workflows, monitor failures, and move to mainnet only when ready.</p></article>
    </div>
  </section>

  <section class="section">
    <div class="section-head">
      <p class="eyebrow">Dual-mode Cloud</p>
      <h2>Checkout orders and account deposits in one hosted system.</h2>
    </div>
    <div class="grid two">
      <article class="card large cloud"><h3>Order Mode</h3><p class="muted">For checkout, invoices, payment links, and one-time payment requests. PayIn Cloud monitors the transaction and notifies your system when it is ready to fulfill.</p></article>
      <article class="card large open"><h3>Deposit Mode</h3><p class="muted">For account funding, user balances, and assigned receiving addresses. PayIn Cloud helps detect incoming funds and connect them to your business records.</p></article>
    </div>
  </section>

  <section class="section">
    <div class="quote-band">
      <p class="eyebrow">Cloud docs</p>
      <h2>Everything your integration team needs to start.</h2>
      <p>Read the public Cloud docs for API keys, sandbox testing, order payments, hosted payment pages, webhooks, reconciliation, support, and production launch.</p>
      <div class="actions">
        <a class="button" href={withBase('/docs/cloud/getting-started/')}>Get started</a>
        <a class="button secondary" href={withBase('/docs/cloud/webhooks/')}>Webhook docs</a>
      </div>
    </div>
  </section>
</BaseLayout>
