---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const withBase = (path: string) => `${base}/${path.replace(/^\//, '')}`;
const networkTokens = [
  ['USDC', 't1', ''],
  ['USDT', 't2', 'green'],
  ['Ethereum', 't3', 'dark'],
  ['Solana', 't4', 'orange'],
  ['Base', 't5', ''],
  ['Polygon', 't6', 'dark'],
  ['Tron', 't7', 'green'],
  ['Arbitrum', 't8', ''],
];
---
<BaseLayout title="Stablecoin payment infrastructure for real merchants" description="PayIn turns multi-chain stablecoins into non-custodial merchant payment operations for Cloud and Open deployments.">
  <section class="hero wide hero-panel">
    <div>
      <div class="hero-kicker-row">
        <p class="eyebrow">Stablecoin payment infrastructure</p>
        <span class="trust-pill">Non-custodial by design</span>
      </div>
      <h1>Stablecoin payments for real merchants.</h1>
      <p class="lead">PayIn turns multi-chain stablecoins into merchant payment operations — orders, deposits, payment pages, webhooks, and reconciliation — while merchants keep custody control.</p>
      <div class="actions">
        <a class="button cloud" href={withBase('/cloud/')}>Explore PayIn Cloud</a>
        <a class="button open" href={withBase('/open/')}>View PayIn Open</a>
      </div>
      <div class="hero-proof" aria-label="PayIn summary points">
        <div class="proof-item"><strong>Cloud</strong>Hosted service layer</div>
        <div class="proof-item"><strong>Open</strong>Self-hosted infrastructure</div>
        <div class="proof-item"><strong>Go</strong><a href="https://go.payin.com/">Face-to-face app ↗</a></div>
      </div>
    </div>

    <aside class="payment-flow-card" aria-label="Non-custodial payment flow">
      <div class="flow-topline">
        <span class="mini-label">Non-custodial payment flow</span>
        <span class="live-dot">observed by PayIn</span>
      </div>
      <div class="flow-stage">
        <div class="wallet-node">
          <div class="node-label">Payer</div>
          <div class="node-title">Customer wallet</div>
          <div class="node-sub">USDC / USDT on a supported network</div>
        </div>
        <div class="settlement-line" aria-hidden="true"></div>
        <div class="merchant-node">
          <div class="node-label">Merchant</div>
          <div class="node-title">Merchant-controlled destination</div>
          <div class="node-sub">Funds settle on-chain under merchant custody control</div>
        </div>
      </div>
      <div class="payin-observer">
        <div class="observer-copy">
          <strong>PayIn coordinates the payment state.</strong>
          <span>PayIn is the operations layer, not the custody layer.</span>
        </div>
        <div class="observer-list">
          <span>Payment request</span>
          <span>Chain confirmation</span>
          <span>Webhook event</span>
          <span>Reconciliation record</span>
        </div>
      </div>
    </aside>
  </section>

  <section class="section">
    <div class="constellation">
      <div class="constellation-inner">
        <div class="constellation-copy">
          <p class="eyebrow">Multi-chain stablecoin layer</p>
          <h2>Stablecoins are multi-chain. PayIn makes them merchant-ready.</h2>
          <p>Customers may use different stablecoins across different networks. PayIn gives merchants one payment operations layer across supported stablecoins, networks, order flows, and deposit flows.</p>
        </div>
        <div class="orbit-map" aria-label="Stablecoin and network constellation">
          <div class="orbit-ring"></div>
          <div class="orbit-ring two"></div>
          <div class="orbit-center"><span class="wordmark">payin<span class="wordmark-dot"></span></span></div>
          {networkTokens.map(([label, pos, color]) => (
            <span class={`orbit-token ${pos}`}><span class={`coin ${color}`}>{label.slice(0, 1)}</span>{label}</span>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="section-head">
      <p class="eyebrow">Merchant payment layer</p>
      <h2>PayIn turns stablecoins into payment operations.</h2>
      <p>Build order payments, deposit flows, payment pages, blockchain monitoring, webhook delivery, reconciliation, and production controls on top of multi-chain stablecoin settlement.</p>
    </div>
    <div class="grid four">
      <article class="card"><h3>Order payments</h3><p class="muted">Checkout, invoices, and payment links tied to business records.</p></article>
      <article class="card"><h3>Deposit flows</h3><p class="muted">Assigned addresses and account funding workflows.</p></article>
      <article class="card"><h3>Webhooks</h3><p class="muted">Payment state delivered into merchant systems.</p></article>
      <article class="card"><h3>Reconciliation</h3><p class="muted">Payment records connected to orders, deposits, and ledger workflows.</p></article>
    </div>
  </section>

  <section class="section">
    <div class="section-head">
      <p class="eyebrow">Dual-mode payments</p>
      <h2>Order Mode + Deposit Mode in one system.</h2>
      <p>PayIn is built around the two ways merchants receive money: specific payment requests and account-style receiving flows.</p>
    </div>
    <div class="mode-showcase">
      <article class="card large cloud mode-visual-card">
        <div>
          <p class="eyebrow small">Order Mode</p>
          <h3>Checkout, invoices, and payment links.</h3>
          <p class="muted">A customer pays a specific order. PayIn tracks the payment state and delivers the event to your system.</p>
        </div>
        <div class="mode-diagram">
          <span>Create order</span>
          <span>Show payment page</span>
          <span>Detect payment</span>
          <span>Fulfill</span>
        </div>
      </article>
      <article class="card large open mode-visual-card">
        <div>
          <p class="eyebrow small">Deposit Mode</p>
          <h3>Account funding and assigned addresses.</h3>
          <p class="muted">A user or account receives funds through a merchant-controlled destination. PayIn monitors and records the deposit flow.</p>
        </div>
        <div class="mode-diagram">
          <span>Assign address</span>
          <span>Monitor deposits</span>
          <span>Confirm transaction</span>
          <span>Credit account</span>
        </div>
      </article>
    </div>
  </section>

  <section class="section">
    <div class="section-head">
      <p class="eyebrow">Cloud and Open</p>
      <h2>Choose your operating model.</h2>
      <p>PayIn Cloud and PayIn Open share the same merchant-first payment model. The difference is who operates the service layer.</p>
    </div>
    <div class="comparison">
      <article class="card large cloud">
        <p class="eyebrow small">Hosted</p>
        <h3>PayIn Cloud</h3>
        <p class="muted">Hosted stablecoin payment infrastructure for online merchants. PayIn operates the service layer; your team integrates API keys, hosted payment pages, webhooks, and reconciliation.</p>
        <div class="steps">
          <span class="step">Fastest path to launch</span>
          <span class="step">Sandbox to production onboarding</span>
          <span class="step">Merchant-controlled funds under a non-custodial model</span>
        </div>
        <div class="actions"><a class="button cloud" href={withBase('/cloud/')}>Explore Cloud</a></div>
      </article>
      <article class="card large open">
        <p class="eyebrow small">Open-source</p>
        <h3>PayIn Open</h3>
        <p class="muted">A complete open-source stablecoin payment stack merchants can self-host. Keep control of infrastructure while using PayIn’s order, deposit, webhook, and operations model.</p>
        <div class="steps">
          <span class="step">Self-hosted payment gateway</span>
          <span class="step">Transparent and auditable infrastructure</span>
          <span class="step">AI-agent-friendly deployment skill</span>
        </div>
        <div class="actions"><a class="button open" href={withBase('/open/')}>Explore Open</a></div>
      </article>
    </div>
  </section>

  <section class="section">
    <div class="quote-band">
      <p class="eyebrow">Start here</p>
      <h2>Hosted with Cloud. Self-hosted with Open.</h2>
      <p>Use PayIn Cloud when you want PayIn to operate the service layer. Use PayIn Open when your team wants a self-hosted open-source stack. PayIn Go remains available for face-to-face payments at go.payin.com.</p>
      <div class="actions">
        <a class="button" href={withBase('/cloud/')}>Start with Cloud</a>
        <a class="button secondary" href={withBase('/open/')}>Deploy Open</a>
        <a class="button secondary" href="https://go.payin.com/">Open Go ↗</a>
      </div>
    </div>
  </section>
</BaseLayout>
