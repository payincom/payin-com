---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Stablecoin payments for every merchant" description="PayIn builds stablecoin payment products for hosted online payments, self-hosted gateways, and in-person merchants.">
  <section class="hero">
    <p class="eyebrow">Stablecoin payment infrastructure</p>
    <h1>PayIn products for online, self-hosted, and in-person merchants.</h1>
    <p class="lead">PayIn helps merchants accept stablecoin payments through hosted cloud services, open-source self-hosting, and face-to-face payment products.</p>
    <div class="actions">
      <a class="button" href="/docs/">Explore docs</a>
      <a class="button secondary" href="/blog/">Read the blog</a>
    </div>
  </section>

  <section>
    <h2>Product lines</h2>
    <div class="grid">
      <article class="card">
        <h3>PayIn Cloud</h3>
        <p class="muted">Hosted stablecoin payment cloud service for online businesses. PayIn operates the infrastructure; merchants integrate APIs and webhooks.</p>
      </article>
      <article class="card">
        <h3>PayIn Open</h3>
        <p class="muted">Self-hosted open-source payment gateway for online businesses that want independent deployment and operations.</p>
      </article>
      <article class="card">
        <h3>PayIn Go</h3>
        <p class="muted">Face-to-face payment product for in-person merchants and point-of-sale style payment flows.</p>
      </article>
    </div>
  </section>
</BaseLayout>
