---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const withBase = (path: string) => `${base}/${path.replace(/^\//, '')}`;
const coins = ['USDC', 'USDT', 'PYUSD', 'DAI'];
const networks = ['Ethereum', 'Polygon', 'Solana', 'Base', 'Arbitrum', 'BNB Chain', 'Tron', 'Optimism'];
---
<BaseLayout title="Stablecoin Payments" description="Why stablecoins matter for merchant payments and how PayIn makes multi-chain stablecoin operations usable.">
  <section class="hero">
    <p class="eyebrow">Stablecoin payments</p>
    <h1>Stablecoins are becoming merchant payment rails.</h1>
    <p class="lead">Stablecoins are fast, global, programmable, and available 24/7. PayIn turns them into non-custodial merchant-ready payment infrastructure across supported tokens, networks, order flows, deposit flows, webhooks, and reconciliation.</p>
  </section>

  <section class="section">
    <div class="section-head">
      <p class="eyebrow">The advantage</p>
      <h2>Why merchants care about stablecoins.</h2>
    </div>
    <div class="grid four">
      <article class="card"><h3>Speed</h3><p class="muted">Move value across global stablecoin settlement windows.</p></article>
      <article class="card"><h3>Global access</h3><p class="muted">Reach customers and partners across borders with a common digital settlement layer.</p></article>
      <article class="card"><h3>Programmability</h3><p class="muted">Build payment creation, monitoring, notifications, and reconciliation into software.</p></article>
      <article class="card"><h3>Price clarity</h3><p class="muted">USD-denominated stablecoins are easier for merchant pricing than volatile crypto assets.</p></article>
    </div>
  </section>

  <section class="section">
    <div class="section-head">
      <p class="eyebrow">Non-custodial model</p>
      <h2>Stablecoin payments work best when merchants keep control of funds.</h2>
      <p>PayIn is not positioned as a wallet, exchange, or custodian. It is the payment infrastructure layer that helps merchants request payments, detect settlement, deliver webhooks, and reconcile records while funds remain under merchant-defined custody arrangements.</p>
    </div>
    <div class="grid">
      <article class="card"><h3>Less custody risk</h3><p class="muted">The platform remains the payment operations layer while merchants control custody.</p></article>
      <article class="card"><h3>Clear trust story</h3><p class="muted">Merchants can explain PayIn as payment verification and operations infrastructure.</p></article>
      <article class="card"><h3>Works for Cloud and Open</h3><p class="muted">Cloud hosts the service layer; Open lets merchants self-host the stack.</p></article>
    </div>
  </section>

  <section class="section">
    <div class="section-head">
      <p class="eyebrow">Multi-chain</p>
      <h2>Stablecoins move across many networks.</h2>
      <p>Customers may hold different stablecoins on different chains. PayIn’s job is to make that multi-chain world operationally simple for merchants.</p>
    </div>
    <div class="card large">
      <p class="mini-label">Stablecoins</p>
      <div class="pill-row">{coins.map((coin) => <span class="pill"><span class="coin">{coin.slice(0,1)}</span>{coin}</span>)}</div>
      <p class="mini-label" style="margin-top: 1.5rem;">Networks</p>
      <div class="pill-row">{networks.map((network) => <span class="pill"><span class="coin dark">{network.slice(0,1)}</span>{network}</span>)}</div>
      <p class="muted" style="margin-top:1.25rem;">Support should be shown honestly as current, upcoming, or planned. The strategic message is clear: merchants should not rebuild payment logic for every chain.</p>
    </div>
  </section>

  <section class="section">
    <div class="section-head">
      <p class="eyebrow">Merchant infrastructure</p>
      <h2>From transactions to operations.</h2>
      <p>Stablecoins provide the settlement layer. PayIn provides the merchant layer.</p>
    </div>
    <div class="grid">
      <article class="card"><h3>Payment orders</h3><p class="muted">Checkout, invoice, and payment link flows tied to business records.</p></article>
      <article class="card"><h3>Deposit addresses</h3><p class="muted">Assigned addresses and account funding flows for platforms and balances.</p></article>
      <article class="card"><h3>Webhooks and reconciliation</h3><p class="muted">Operational workflows that connect chain events to merchant systems.</p></article>
    </div>
  </section>

  <section class="section">
    <div class="quote-band">
      <p class="eyebrow">Choose your path</p>
      <h2>Hosted with Cloud. Self-hosted with Open.</h2>
      <p>PayIn Cloud is the hosted path for merchants who want PayIn to operate the infrastructure. PayIn Open is the self-hosted open-source path for teams that want control.</p>
      <div class="actions"><a class="button" href={withBase('/cloud/')}>PayIn Cloud</a><a class="button secondary" href={withBase('/open/')}>PayIn Open</a></div>
    </div>
  </section>
</BaseLayout>
