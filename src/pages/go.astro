---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="PayIn Go" description="PayIn Go is the face-to-face stablecoin payment product for in-person merchants.">
  <section class="hero">
    <p class="eyebrow">PayIn Go</p>
    <h1>Face-to-face stablecoin payments for in-person merchants.</h1>
    <p class="lead">PayIn Go is the PayIn product for in-person and point-of-sale style payment flows. The app remains separate and is owned by the PayIn Go product repository.</p>
    <div class="actions"><a class="button" href="https://go.payin.com/">Open go.payin.com ↗</a></div>
  </section>
  <section class="section">
    <div class="grid">
      <article class="card go"><h3>In-person checkout</h3><p class="muted">Lightweight payment requests for face-to-face merchant scenarios.</p></article>
      <article class="card go"><h3>QR-style flows</h3><p class="muted">Designed for quick customer handoff and clear payment confirmation.</p></article>
      <article class="card go"><h3>Separate product app</h3><p class="muted">This website links to PayIn Go; it does not replace the go.payin.com application.</p></article>
    </div>
  </section>
</BaseLayout>
